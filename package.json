{
  "name": "pirate-battle",
  "private": true,
  "version": "1.0.0",
  "description": "Top-down 2D naval shooter built with React, TypeScript and PixiJS.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty",
    "test:unit": "vitest run",
    "balance": "BALANCE=1 vitest run scripts/balance.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:e2e:report": "playwright show-report reports/playwright",
    "check": "npm run lint && npm run typecheck && npm run test:unit"
  },
  "dependencies": {
    "@fontsource/rubik": "^5.3.0",
    "@tanstack/react-query": "^5.104.0",
    "axios": "^1.20.0",
    "pixi.js": "^8.21.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tanstack/react-query-devtools": "^5.104.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "msw": "^3.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}